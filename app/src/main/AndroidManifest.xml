<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera access for measuring light -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 24h+ background logging -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Partial wake lock so the phone keeps sampling with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Persistent "logging" notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Open-Meteo weather context (no API key needed) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- This app NEEDS a camera. It cannot be installed on cameras-less devices. -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.DaylightLogger">

        <!-- Main screen: live camera display + readings + chart + gear icon -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gear icon -> settings (interval, k, device mode, export, clear) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- Calibration: enter a reference lux, app computes k -->
        <activity
            android:name=".CalibrationActivity"
            android:exported="false"
            android:label="Calibration" />

        <!-- Update log: every version + download links to older releases -->
        <activity
            android:name=".UpdateLogActivity"
            android:exported="false"
            android:label="Update log" />

        <!-- Long-running logger so samples continue with the screen off -->
        <service
            android:name=".LoggingService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Lets the "Export CSV" share sheet read our log file -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
